<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked app uploaded by the
     Release workflow (a zip of dist/win-unpacked). Signs our executable only;
     Electron's own libraries are third-party files and are left as shipped. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Music Player.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
