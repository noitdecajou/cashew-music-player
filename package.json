{
  "name": "music-player",
  "productName": "Music Player",
  "version": "2.4.0-beta.2",
  "private": true,
  "description": "YouTube Music desktop player with a mini-player, for Windows",
  "license": "MIT",
  "author": "noitdecajou",
  "repository": {
    "type": "git",
    "url": "https://github.com/noitdecajou/cashew-music-player.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings src build test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node test/e2e/run.mjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64",
    "test:live": "electron-vite build && node test/live/ytm-live.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "koffi": "3.3.4"
  }
}
